{
  "name": "@jamolpe88/dsh-opencodego-usage",
  "version": "0.1.4",
  "description": "OpenCode Go subscription usage in the DeepSeek Harness composer: 5-hour, weekly and monthly windows with a click-open details panel. Zero configuration.",
  "keywords": [
    "dsh",
    "deepseek-harness",
    "dsh-plugin",
    "opencode",
    "opencode-go",
    "usage",
    "subscription",
    "composer"
  ],
  "license": "MIT",
  "author": "JaMoLpE88",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JaMoLpE88/dsh-opencodego-usage.git"
  },
  "homepage": "https://github.com/JaMoLpE88/dsh-opencodego-usage#readme",
  "bugs": {
    "url": "https://github.com/JaMoLpE88/dsh-opencodego-usage/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "engines": {
    "node": ">=22",
    "dsh": ">=0.2.1-rc.3"
  },
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.png",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  },
  "files": [
    "index.js",
    "usage.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.png",
    "assets/*.png",
    "NOTICE",
    "README.md",
    "README.es.md",
    "CHANGELOG.md",
    "SECURITY.md",
    "LICENSE"
  ],
  "scripts": {
    "check": "node --check index.js && node --check usage.js && node --check client.js",
    "test": "node --test"
  }
}
